{
  "openapi": "3.1.0",
  "info": {
    "title": "PotLudo Tournament API",
    "version": "1.0.0",
    "description": "Free knockout tournaments. Existing X-Session-Token identity and opaque admin Bearer sessions. Paid drafts can be saved; payment routes and paid publication return 423. Requires MongoDB transactions (replica set or sharded deployment)."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
