  "components": {
    "securitySchemes": {
      "PlayerSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Session-Token"
      },
      "AdminSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing opaque admin session token, not a JWT."
      }
    },
    "schemas": {
      "TournamentConfig": {
        "type": "object",
        "required": [
          "name",
          "registrationStart",
          "registrationEnd",
          "startAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "bannerUrl": {
            "type": "string"
          },
          "entryType": {
            "type": "string",
            "enum": [
              "FREE",
              "PAID"
            ],
            "default": "FREE"
          },
          "gameFormat": {
            "type": "integer",
            "enum": [
              2,
              4
            ]
          },
          "maxParticipants": {
            "type": "integer",
            "minimum": 2,
            "maximum": 512
          },
          "entryFee": {
            "type": "integer",
            "minimum": 0
          },
          "prizePoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "qualifiersPerRound": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          },
          "joinTimeoutSeconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 1800
          },
          "matchDurationSeconds": {
            "type": "integer",
            "minimum": 300,
            "maximum": 14400
          },
          "reconnectSeconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 300
          },
          "rules": {
            "type": "string",
            "minLength": 20,
            "maxLength": 8000
          },
          "registrationStart": {
            "type": "string",
            "format": "date-time"
          },
          "registrationEnd": {
            "type": "string",
            "format": "date-time"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminAction": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "userId": {
            "type": "string"
          },
          "matchId": {
            "type": "string"
          }
        }
      }
    }
  }
