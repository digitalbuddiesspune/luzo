      "get": {
        "summary": "List published tournaments",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid configuration or input"
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Not assigned or not authorized"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Invalid transition, capacity exhausted, or concurrent change; refresh before retrying"
          },
          "423": {
            "description": "Paid entry and cash operations disabled"
          }
        }
      }
    },
